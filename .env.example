# Copy to .env (next to docker-compose.yml) and fill in.
MYSQL_ROOT_PASSWORD=
# Generate with: openssl rand -base64 64 | tr -d '\n'
JWT_BASE64_SECRET=
# Host port and bind address per service. 127.0.0.1 keeps a port local to the server; 0.0.0.0 opens it to the LAN.
MYSQL_PORT=3319
MYSQL_BIND=127.0.0.1
BACKEND_PORT=11124
BACKEND_BIND=127.0.0.1
FRONTEND_PORT=18088
FRONTEND_BIND=127.0.0.1
