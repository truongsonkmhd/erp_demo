# Copy to .env (next to docker-compose.yml) and fill in.
MYSQL_ROOT_PASSWORD=
# Generate with: openssl rand -base64 64 | tr -d '\n'
JWT_BASE64_SECRET=
# Host port and bind address per service. 127.0.0.1 keeps a port local to the server; 0.0.0.0 opens it to the LAN.
MYSQL_PORT=3319
MYSQL_BIND=127.0.0.1
BACKEND_PORT=11124
BACKEND_BIND=127.0.0.1
FRONTEND_PORT=18088
FRONTEND_BIND=127.0.0.1
# Notification e-mails (optional). Gmail: turn on 2-step verification, create an App Password, then:
# MAIL_HOST=smtp.gmail.com  MAIL_USERNAME=you@gmail.com  MAIL_PASSWORD=<16-char app password>
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# Public address of the web app, used for links in e-mails (e.g. https://erp.example.vn).
APP_PUBLIC_URL=
